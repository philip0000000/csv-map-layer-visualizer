{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:desktop": "vite build --mode desktop",
    "desktop:dev": "concurrently -k \"npm run dev -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node desktop/run-electron.cjs . --dev-server=http://127.0.0.1:5173\"",
    "desktop:start": "npm run build:desktop && node desktop/run-electron.cjs .",
    "smoke:desktop-workflow": "electron desktop/desktopCsvWorkflow.smoke.cjs",
    "smoke:csv-import-batch": "electron desktop/csvImportService.smoke.cjs",
    "smoke:csv-import-drop": "electron desktop/droppedCsvImport.smoke.cjs",
    "smoke:desktop-data-source": "node src/data/desktopSqliteDataSource.smoke.js",
    "smoke:sqlite-datasets": "electron desktop/sqliteDatasetService.smoke.cjs",
    "smoke:sqlite-store": "electron desktop/sqliteStore.smoke.cjs",
    "smoke:sqlite-viewport": "node desktop/sqliteViewportQuery.smoke.cjs",
    "smoke:sqlite-detail": "node desktop/sqliteDetailQuery.smoke.cjs",
    "validate:desktop-large-file": "node desktop/largeFileValidation.cjs",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "leaflet": "^1.9.4",
    "leaflet-polylinedecorator": "^1.6.0",
    "leaflet.markercluster": "^1.5.3",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.0.0",
    "sql.js": "1.14.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^7.2.4",
    "wait-on": "^9.0.10"
  }
}
